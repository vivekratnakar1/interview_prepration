// 1. Pehle humne ek Functional Interface banaya
@FunctionalInterface
interface IBankOperation {
    void execute(String accountHolder, double amount);
}

public class MainBankingPOC {
    public static void main(String[] args) {
        
        // 2. Deposit Lambda Expression (Adds money logic)
        IBankOperation depositMoney = (holder, amount) -> {
            System.out.println("💰 [DEPOSIT] Processing for: " + holder);
            System.out.println("✅ Successfully added $" + amount + " to the account.");
        };

        // 3. Withdraw Lambda Expression (Subtracts money with safety check)
        IBankOperation withdrawMoney = (holder, amount) -> {
            System.out.println("💳 [WITHDRAW] Processing for: " + holder);
            if (amount > 5000.0) {
                System.out.println("❌ FAILED: Maximum daily withdrawal limit is $5000!");
            } else {
                System.out.println("✅ Successfully withdrew $" + amount);
            }
        };

        // 4. Run checking (Testing both logics)
        depositMoney.execute("Amit Sharma", 1500.00);
        System.out.println("----------------------------------------");
        
        withdrawMoney.execute("Priya Patel", 7500.00); // This will trigger the limit error
        System.out.println("----------------------------------------");
        
        withdrawMoney.execute("Rahul Kumar", 2000.00); // This will succeed
    }
}
